# ====================================================================
# AI Developer Assistant - Backend Environment Configuration Template
# ====================================================================

# Backend Server Configuration
FLASK_ENV=development
PORT=5000
SECRET_KEY=change-this-to-a-secure-random-secret-key-in-production
JWT_SECRET_KEY=change-this-to-a-secure-jwt-secret-key-in-production
BACKEND_URL=http://127.0.0.1:5000
FRONTEND_URL=http://localhost:3000
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173
COOKIE_SECURE=false

# MySQL 8.0 Database Connection Settings
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=ai_developer_assistant
DB_USER=root
DB_PASSWORD=

# Google Gemini API Configuration (Official Google GenAI SDK)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=models/text-embedding-004
GEMINI_REQUEST_TIMEOUT=45

# Durable Storage & File Sandbox (mount durable disk/EFS/volume here in production)
STORAGE_DIR=storage/projects
MAX_CONTENT_LENGTH=52428800

# GitHub REST API Integration (Optional - for higher rate limits on public repos)
GITHUB_API_TOKEN=
